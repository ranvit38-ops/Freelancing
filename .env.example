# ──────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets. `.env*` is gitignored.
# Vars are validated at startup by src/lib/env.ts (Zod) — bad formats fail loud.
# ──────────────────────────────────────────────────────────────────────────

# Public base URL of the site. Used for Stripe redirects, sitemap, OG, emails.
# Local dev default is http://localhost:3000 — set the real domain in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Stripe (required only if features.ecommerce is true) ───────────────────
# Get these from https://dashboard.stripe.com (use TEST keys while developing).
# Secret key — starts with sk_test_ (test) or sk_live_ (live).
STRIPE_SECRET_KEY="sk_test_xxx"
# Webhook signing secret — starts with whsec_.
# Local: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# which prints this value. Prod: copy it from the Stripe webhook endpoint UI.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Resend transactional email (required only if email is used) ────────────
# API key from https://resend.com/api-keys — starts with re_.
RESEND_API_KEY="re_xxx"
# Verified sender. Domain MUST have SPF/DKIM/DMARC verified in Resend or mail
# goes to spam. Format: "Display Name <address@yourdomain.com>".
EMAIL_FROM="Northwind Studio <hello@yourdomain.com>"
# Optional: where contact-form submissions are delivered.
# Falls back to contact.inboxEmail / contact.email in site.config.ts.
CONTACT_INBOX_EMAIL="hello@yourdomain.com"

# ── Software adapter (client's external system) ────────────────────────────
# Which adapter to use. "mock" (default) logs instead of integrating.
# Add real adapters in src/software-adapter/ once you have the client's API docs.
SOFTWARE_ADAPTER="mock"
# SETUP REQUIRED: add the client's API credentials here for a real adapter, e.g.
# HUBSPOT_TOKEN="..."
