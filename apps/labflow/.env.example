# Copy to .env.local and fill in. Never commit real secrets.

# Required. Postgres 14+ (Supabase connection strings work unchanged).
DATABASE_URL="postgres://postgres@localhost:5432/labflow"

# Optional. Defaults shown.
SESSION_COOKIE_NAME="labflow_session"
UPLOAD_DIR=".uploads"

# Optional. Without this, AI features render an honest "not configured"
# state instead of inventing analysis. Never expose this to the browser.
ANTHROPIC_API_KEY=""
# Opus 5 is the default and the most capable. Sonnet 5 costs roughly a
# third as much per token and is a reasonable swap if the LabBot bill
# ever matters: LABFLOW_AI_MODEL="claude-sonnet-5"
LABFLOW_AI_MODEL="claude-opus-5"

# Optional. Without these, password-reset links are written to the server log
# instead of being emailed, and the UI says so.
RESEND_API_KEY=""
EMAIL_FROM="LabFlow <labflow@yourdomain.com>"
# Absolute base URL used in emailed links.
# The public address people type in. Required in production: payment
# redirects and email links are built from it, and a deployment without one
# refuses to open checkout rather than stranding a paying customer.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Optional. PubMed works without a key (3 req/s); a key raises it to 10 req/s.
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=""

# ── Payments (Stripe) ──────────────────────────────────────────────────────
# Without these, the pricing page renders but checkout says it is unavailable.
# Create three recurring prices in the Stripe dashboard, then paste their ids.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_LAB=""
STRIPE_PRICE_GROUP=""
STRIPE_PRICE_DEPARTMENT=""

# Local exploration only. Treats every workspace as if it were on the top plan
# so you can navigate the whole product without paying. Ignored in production —
# NODE_ENV is checked, so this cannot ship as a backdoor.
LABFLOW_DISABLE_PAYWALL=""

# Owner unlock code. When set, /billing shows a box where redeeming this code
# comps the current workspace onto the Department plan. Leave empty to remove
# the box entirely. Use a long random string — treat it like a password.
LABFLOW_OWNER_UNLOCK=""

# ── Google sign-in ─────────────────────────────────────────────────────────
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# as an authorised redirect URI. Without both values the button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The deployment owner's email. Signing in with this address for the first time
# comps that workspace onto the Department plan. Deliberately not hardcoded:
# a privileged address in source is permanent, public, and a spam magnet.
LABFLOW_OWNER_EMAIL=""
