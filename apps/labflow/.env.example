# Copy to .env.local and fill in. Never commit real secrets.

# Required. Postgres 14+ (Supabase connection strings work unchanged).
DATABASE_URL="postgres://postgres@localhost:5432/labflow"

# Optional. Defaults shown.
SESSION_COOKIE_NAME="labflow_session"
UPLOAD_DIR=".uploads"

# Optional. Without this, AI features render an honest "not configured"
# state instead of inventing analysis. Never expose this to the browser.
# Encrypts secrets labs hand over, such as their own Claude key. Any long
# random string; changing it makes stored keys unreadable (labs re-add them).
# Unset, labs cannot add their own key and the form says why.
LABFLOW_ENCRYPTION_KEY=""

ANTHROPIC_API_KEY=""
# Opus 5.5 is the default (also used to fill the experiment form from a
# description). Sonnet 5.5 costs half as much per token and is a reasonable
# swap if the bill ever matters: LABFLOW_AI_MODEL="claude-sonnet-5-5"
LABFLOW_AI_MODEL="claude-opus-5-5"
# LabBot and "Catch me up" use the fastest model so answers start in about a
# second. Set to claude-opus-5-5 for more careful answers at several times the
# wait and cost.
LABFLOW_LABBOT_MODEL="claude-haiku-5-5"

# Email (invitations, password resets, sign-up confirmations) via Resend.
# Without these, invitations show a link to pass on yourself, reset links go
# to the server log, and the UI says so. Settings > Email has a "Send a test
# email" button that shows Resend's exact answer.
#
# EMAIL_FROM="Labquill <onboarding@resend.dev>" works with no domain, but Resend
# then ONLY delivers to the address that owns the Resend account. To email
# anyone else, verify a domain at resend.com/domains and send from it.
RESEND_API_KEY=""
EMAIL_FROM="Labquill <hello@yourdomain.com>"
# Absolute base URL used in emailed links.
# The public address people type in. Required in production: payment
# redirects and email links are built from it, and a deployment without one
# refuses to open checkout rather than stranding a paying customer.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Optional. PubMed works without a key (3 req/s); a key raises it to 10 req/s.
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=""

# ── Payments (PayPal) ──────────────────────────────────────────────────────
# Without these, the pricing page renders but Billing says payments are not set
# up. BILLING.md has the steps; `npm run paypal:setup -- --create` makes the
# plans and prints the ids. Sandbox unless PAYPAL_ENV is exactly "live".
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_LAB_MONTHLY=""
PAYPAL_PLAN_LAB_YEARLY=""
PAYPAL_PLAN_GROUP_MONTHLY=""
PAYPAL_PLAN_GROUP_YEARLY=""
PAYPAL_PLAN_DEPARTMENT_MONTHLY=""
PAYPAL_PLAN_DEPARTMENT_YEARLY=""

# Local exploration only. Treats every workspace as if it were on the top plan
# so you can navigate the whole product without paying. It is ignored in
# production: NODE_ENV is checked, so this cannot ship as a backdoor.
LABFLOW_DISABLE_PAYWALL=""

# ── Free pilot ─────────────────────────────────────────────────────────────
# Set to 1 to run this deployment as a free pilot: every workspace gets the
# Department plan, with no expiry, no seat cap to argue with and no prompt to
# pay. The billing page becomes four questions about whether the lab would pay
# instead, and the answers show up on the owner dashboard beside how much each
# lab actually used the product.
#
# Unlike LABFLOW_DISABLE_PAYWALL this works in production, because a pilot is a
# production deployment. It is therefore the one setting that can give the
# product away by accident: the owner dashboard says loudly when it is on.
LABFLOW_PILOT_MODE=""

# Owner unlock code. When set, /billing shows a box where redeeming this code
# comps the current workspace onto the Department plan. Leave empty to remove
# the box entirely. Use a long random string and treat it like a password.
LABFLOW_OWNER_UNLOCK=""

# ── Google sign-in ─────────────────────────────────────────────────────────
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# as an authorised redirect URI. Without both values the button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: "Import from Google Drive" on the Files page. Uses the same OAuth
# client as sign-in, plus a browser API key: Google Cloud console > APIs &
# Services > enable "Google Drive API" and "Google Picker API" > Credentials >
# Create credentials > API key, restricted to your site's address and to the
# Picker API. Add the scope .../auth/drive.file to the OAuth consent screen.
# drive.file only grants access to the files a person picks, never their whole
# Drive.
GOOGLE_API_KEY=""

# The deployment owner's email. Signing in with this address for the first time
# comps that workspace onto the Department plan. Deliberately not hardcoded:
# a privileged address in source is permanent, public, and a spam magnet.
# The owner page (/owner, every lab on the deployment) only opens once the
# account has proved it owns the address: sign in with Google, or use "Forgot
# password" once. Anyone can type an address into a sign-up form.
LABFLOW_OWNER_EMAIL=""

# Who the Terms and the Privacy statement name as running this site, where
# people write to about their data, and the US state whose law governs the
# Terms. Unset, those pages say no operator or contact has been named.
# Prefer a company (an LLC) over a person's own name.
LABFLOW_LEGAL_NAME=""
LABFLOW_CONTACT_EMAIL=""
LABFLOW_GOVERNING_LAW=""

# Set to 1 on a host with no persistent disk (Render's free tier). Uploaded
# files are then kept in the database instead, so they survive restarts and
# redeploys. Files are capped at 25 MB each there (video included), because
# every file passes through the server's memory.
LABFLOW_EPHEMERAL_UPLOADS=""
# Override where files go: "database" or "disk". Unset follows the line above.
# "disk" with LABFLOW_EPHEMERAL_UPLOADS=1 shows a warning on every page that
# files are lost on restart.
LABFLOW_FILE_STORAGE=""
# Ceiling on files kept in the database, in MB. Neon's free plan holds 512 MB
# in total and a full database refuses every write, so the default of 300
# leaves room for everything else.
LABFLOW_DB_STORAGE_MB=""
