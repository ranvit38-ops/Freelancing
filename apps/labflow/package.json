{
  "name": "labflow",
  "version": "0.1.0",
  "private": true,
  "description": "LabFlow \u2014 turn experiments into a living research record.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.33.0",
    "jszip": "^3.10.1",
    "next": "14.2.35",
    "papaparse": "5.4.1",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/papaparse": "5.3.14",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.47.2",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
