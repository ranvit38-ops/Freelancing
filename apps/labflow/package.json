{
  "name": "labflow",
  "version": "0.1.0",
  "private": true,
  "description": "Labquill — turn experiments into a living research record.",
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "pilot": "LABFLOW_PILOT_MODE=1 next dev -p 3001 -H 0.0.0.0",
    "pilot:check": "node scripts/pilot-check.mjs",
    "prebuild": "node scripts/notices.mjs",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node scripts/migrate.mjs",
    "db:seed": "tsx src/db/seed.ts",
    "e2e": "node e2e/pipelines.mjs",
    "e2e:billing": "node e2e/billing.mjs",
    "e2e:fakes": "node e2e/fakes.mjs",
    "setup": "node scripts/setup.mjs",
    "paypal:setup": "tsx scripts/paypal-setup.ts",
    "e2e:responsive": "node e2e/responsive.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.1",
    "next": "^16.4.3",
    "papaparse": "5.4.1",
    "pg": "8.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/papaparse": "5.3.14",
    "@types/pg": "8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.47.2",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
